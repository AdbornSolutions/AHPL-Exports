# Server-side only. Add this in Vercel Project Settings > Environment Variables.
# Never prefix this variable with VITE_, because VITE_ variables are public.
GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Separate Apps Script deployment for the Contact Us form.
GOOGLE_CONTACT_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/YOUR_CONTACT_DEPLOYMENT_ID/exec
